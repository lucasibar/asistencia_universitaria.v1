PORT=3000
DATABASE_URL=postgresql://postgres:password@localhost:5432/asistencia
# For Supabase use SSL with certificate verification (system CA or supplied CA).
DATABASE_SSL=false
# DATABASE_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
QR_SIGNING_SECRET=replace-with-at-least-32-random-characters
QR_ROTATION_SECONDS=10
ATTEMPT_TTL_SECONDS=60
# Only enable for a known reverse-proxy topology. Render normally has one hop.
TRUST_PROXY_HOPS=0
