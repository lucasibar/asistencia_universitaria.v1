{
  "name": "asistencia-universitaria-backend",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": "22.x" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "dev": "tsc-watch --onSuccess \"node dist/main.js\"",
    "migrate": "tsx scripts/migrate.ts",
    "test": "npm run build && tsx --test test/*.test.ts",
    "check": "npm test"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/throttler": "^6.4.0",
    "@supabase/supabase-js": "^2.57.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "overrides": { "multer": "^2.3.0" },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@types/express": "^5.0.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "tsc-watch": "^7.2.0"
  }
}
